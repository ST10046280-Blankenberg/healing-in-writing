
@model HealingInWriting.Models.Common.TermsOfServiceViewModel

@{
    ViewData["Title"] = "Terms of Service";
}

@section Styles {
    <link rel="stylesheet" href="~/css/shared/page-hero.css" />
    <link rel="stylesheet" href="~/css/views/terms-of-service.css" />
}

<div class="terms">
    <!-- Hero Section -->
    <section class="page-hero">
        <div class="page-hero__content">
            <h1 class="page-hero__title">Terms of Service</h1>
            <p class="page-hero__subtitle">Please read these terms carefully before using our services.</p>
        </div>
    </section>

    <!-- Body Section -->
    <section class="terms__body">
        <div class="terms__container">
            @Html.Raw(Model?.Content ?? string.Empty)

        </div>
    </section>
</div>
