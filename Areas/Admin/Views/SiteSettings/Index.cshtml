@model HealingInWriting.Models.Common.SiteSettingsViewModel

@{
    ViewData["Title"] = "Site Settings";
}

<link rel="stylesheet" href="~/css/shared/search-bar.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/views/admin-site-settings.css" asp-append-version="true" />

<main class="admin-site-settings">
    
    <!-- Donation Settings Section -->
    <section class="donation-settings">
        <div class="donation-settings__header">
            <div>
                <h2 class="donation-settings__title">Bank Account Details</h2>
                <p class="donation-settings__description">Manage the bank account information displayed on the donation page</p>
            </div>
        </div>
        
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" style="padding: 12px; background: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px; color: #155724; margin-bottom: 16px;">
                @TempData["Success"]
            </div>
        }
        
        <form asp-area="Admin" asp-controller="SiteSettings" asp-action="Update" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="BankDetails.Id" type="hidden" />
            <input asp-for="BankDetails.RowVersion" type="hidden" />

            
            <div class="donation-settings__form-grid">
                <div class="donation-settings__field">
                    <label asp-for="BankDetails.BankName" class="donation-settings__label">Bank Name</label>
                    <input asp-for="BankDetails.BankName" class="donation-settings__input" readonly />
                    <span asp-validation-for="BankDetails.BankName" class="text-danger"></span>
                </div>

                <div class="donation-settings__field">
                    <label asp-for="BankDetails.AccountName" class="donation-settings__label">Account Name</label>
                    <input asp-for="BankDetails.AccountName" class="donation-settings__input" readonly />
                    <span asp-validation-for="BankDetails.AccountName" class="text-danger"></span>
                </div>

                <div class="donation-settings__field">
                    <label asp-for="BankDetails.AccountNumber" class="donation-settings__label">Account Number</label>
                    <input asp-for="BankDetails.AccountNumber" class="donation-settings__input" readonly />
                    <span asp-validation-for="BankDetails.AccountNumber" class="text-danger"></span>
                </div>

                <div class="donation-settings__field">
                    <label asp-for="BankDetails.BranchCode" class="donation-settings__label">Branch Code:</label>
                    <input asp-for="BankDetails.BranchCode" class="donation-settings__input" readonly />
                    <span asp-validation-for="BankDetails.BranchCode" class="text-danger"></span>
                </div>

                <div class="donation-settings__field">
                    <label asp-for="BankDetails.AccountType" class="donation-settings__label">Account Type</label>
                    <input asp-for="BankDetails.AccountType" class="donation-settings__input" readonly />
                    <span asp-validation-for="BankDetails.AccountType" class="text-danger"></span>
                </div>

                <div class="donation-settings__field">
                    <label asp-for="BankDetails.Branch" class="donation-settings__label">Branch</label>
                    <input asp-for="BankDetails.Branch" class="donation-settings__input" readonly />
                    <span asp-validation-for="BankDetails.Branch" class="text-danger"></span>
                </div>
            </div>
            
            <div class="donation-settings__actions">
                <button type="button" id="editBtn" class="admin-settings-btn admin-settings-btn--primary donation-settings__btn-edit">Edit</button>
                <button type="submit" id="saveBtn" class="admin-settings-btn admin-settings-btn--primary donation-settings__btn-save hidden">Save</button>
            </div>
        </form>
    </section>
    
    <!-- Policy Editor & Gallery Page Row -->
    <div class="settings-content-row">

        <!-- Policy Editor (Privacy + Terms tabs) -->
        <section class="privacy-editor">
            @{
                var activePolicyTab = ViewBag.ActivePolicyTab ?? TempData["ActivePolicyTab"]?.ToString() ?? "privacy-panel";
            }
            <div class="privacy-editor__header">
                <h2 class="privacy-editor__title">Policy Editor</h2>
                <p class="privacy-editor__description">Edit your privacy policy and terms of service below.</p>
            </div>

            @if (TempData["PrivacySuccess"] != null)
            {
                <div class="alert alert-success" style="padding: 12px; background: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px; color: #155724; margin-bottom: 16px;">
                    @TempData["PrivacySuccess"]
                </div>
            }
            @if (TempData["TermsSuccess"] != null)
            {
                <div class="alert alert-success" style="padding: 12px; background: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px; color: #155724; margin-bottom: 16px;">
                    @TempData["TermsSuccess"]
                </div>
            }

            <div class="policy-tab-bar">
                <button type="button" class="policy-tab-btn @(activePolicyTab.ToString() == "privacy-panel" ? "policy-tab-btn--active" : "")" data-tab="privacy-panel">Privacy Policy</button>
                <button type="button" class="policy-tab-btn @(activePolicyTab.ToString() == "terms-panel" ? "policy-tab-btn--active" : "")" data-tab="terms-panel">Terms of Service</button>
            </div>

            <!-- Privacy Policy Tab Panel -->
            <div id="privacy-panel" class="policy-tab-panel" style="@(activePolicyTab.ToString() == "privacy-panel" ? "" : "display:none;")">
                <form asp-area="Admin" asp-controller="SiteSettings" asp-action="UpdatePrivacyPolicy" method="post" class="policy-editor-form simple-policy-form">
                    @Html.AntiForgeryToken()
                    <input asp-for="PrivacyPolicy.Id" type="hidden" />
                    <input asp-for="PrivacyPolicy.RowVersion" type="hidden" />
                    <input asp-for="PrivacyPolicy.LastUpdated" type="hidden" />

                    <div class="simple-editor__field">
                        <label class="privacy-editor__label">Last Updated</label>
                        <input asp-for="PrivacyPolicy.TemplateData.IntroLastUpdated" class="privacy-editor__input" />
                    </div>

                    <div class="simple-editor__field">
                        <label class="privacy-editor__label">Introduction</label>
                        <div class="simple-editor__toolbar">
                            <button type="button" class="simple-editor__btn" data-command="bold">Bold</button>
                            <button type="button" class="simple-editor__btn" data-command="italic">Italic</button>
                            <button type="button" class="simple-editor__btn" data-command="insertUnorderedList">Bullets</button>
                            <button type="button" class="simple-editor__btn" data-command="createLink">Link</button>
                        </div>
                        <div class="simple-editor__rich-text" contenteditable="true" data-input="PrivacyPolicy.TemplateData.IntroText">@Html.Raw(Model.PrivacyPolicy.TemplateData.IntroText)</div>
                        <input type="hidden" name="PrivacyPolicy.TemplateData.IntroText" value="@Model.PrivacyPolicy.TemplateData.IntroText" />
                    </div>

                    <div class="simple-editor__sections-container">
                        @for (var i = 0; i < Model.PrivacyPolicy.TemplateData.Sections.Count; i++)
                        {
                            var policySection = Model.PrivacyPolicy.TemplateData.Sections[i];
                            <div class="simple-editor__section" data-section-index="@i">
                                <div class="simple-editor__section-header">
                                    <h4 class="simple-editor__section-title">Section @(i + 1)</h4>
                                    <button type="button" class="simple-editor__remove-section admin-settings-btn admin-settings-btn--danger">Remove</button>
                                </div>
                                <label class="privacy-editor__label">Section Title</label>
                                <input name="@($"PrivacyPolicy.TemplateData.Sections[{i}].Title")" value="@policySection.Title" class="privacy-editor__input" />

                                <label class="privacy-editor__label">Section Text</label>
                                <div class="simple-editor__toolbar">
                                    <button type="button" class="simple-editor__btn" data-command="bold">Bold</button>
                                    <button type="button" class="simple-editor__btn" data-command="italic">Italic</button>
                                    <button type="button" class="simple-editor__btn" data-command="insertUnorderedList">Bullets</button>
                                    <button type="button" class="simple-editor__btn" data-command="createLink">Link</button>
                                </div>
                                <div class="simple-editor__rich-text" contenteditable="true" data-input="@($"PrivacyPolicy.TemplateData.Sections[{i}].Body")">@Html.Raw(policySection.Body)</div>
                                <input type="hidden" name="@($"PrivacyPolicy.TemplateData.Sections[{i}].Body")" value="@policySection.Body" />

                                <label class="privacy-editor__label">Bullet List (one per line)</label>
                                <textarea name="@($"PrivacyPolicy.TemplateData.Sections[{i}].BulletsText")" class="privacy-editor__textarea" rows="4">@policySection.BulletsText</textarea>

                                <label class="privacy-editor__label">Highlight Title (optional)</label>
                                <input name="@($"PrivacyPolicy.TemplateData.Sections[{i}].HighlightTitle")" value="@policySection.HighlightTitle" class="privacy-editor__input" />

                                <label class="privacy-editor__label">Highlight Text (optional)</label>
                                <div class="simple-editor__toolbar">
                                    <button type="button" class="simple-editor__btn" data-command="bold">Bold</button>
                                    <button type="button" class="simple-editor__btn" data-command="italic">Italic</button>
                                    <button type="button" class="simple-editor__btn" data-command="insertUnorderedList">Bullets</button>
                                    <button type="button" class="simple-editor__btn" data-command="createLink">Link</button>
                                </div>
                                <div class="simple-editor__rich-text" contenteditable="true" data-input="@($"PrivacyPolicy.TemplateData.Sections[{i}].HighlightBody")">@Html.Raw(policySection.HighlightBody)</div>
                                <input type="hidden" name="@($"PrivacyPolicy.TemplateData.Sections[{i}].HighlightBody")" value="@policySection.HighlightBody" />
                            </div>
                        }
                    </div>

                    <button type="button" class="simple-editor__add-section admin-settings-btn admin-settings-btn--secondary" data-prefix="PrivacyPolicy">+ Add Section</button>

                    <div class="simple-editor__field">
                        <label class="privacy-editor__label">Footer Text</label>
                        <div class="simple-editor__toolbar">
                            <button type="button" class="simple-editor__btn" data-command="bold">Bold</button>
                            <button type="button" class="simple-editor__btn" data-command="italic">Italic</button>
                            <button type="button" class="simple-editor__btn" data-command="insertUnorderedList">Bullets</button>
                            <button type="button" class="simple-editor__btn" data-command="createLink">Link</button>
                        </div>
                        <div class="simple-editor__rich-text" contenteditable="true" data-input="PrivacyPolicy.TemplateData.FooterText">@Html.Raw(Model.PrivacyPolicy.TemplateData.FooterText)</div>
                        <input type="hidden" name="PrivacyPolicy.TemplateData.FooterText" value="@Model.PrivacyPolicy.TemplateData.FooterText" />
                    </div>

                    <div class="simple-editor__field">
                        <label class="privacy-editor__label">Contact Lines (one per line)</label>
                        <textarea name="PrivacyPolicy.TemplateData.ContactLinesText" class="privacy-editor__textarea" rows="4">@Model.PrivacyPolicy.TemplateData.ContactLinesText</textarea>
                    </div>

                    <div class="privacy-editor__actions">
                        <button type="submit" class="admin-settings-btn admin-settings-btn--primary">Save Privacy Policy</button>
                    </div>
                </form>
            </div>

            <!-- Terms of Service Tab Panel -->
            <div id="terms-panel" class="policy-tab-panel" style="@(activePolicyTab.ToString() == "terms-panel" ? "" : "display:none;")">
                <form asp-area="Admin" asp-controller="SiteSettings" asp-action="UpdateTermsOfService" method="post" class="policy-editor-form simple-policy-form">
                    @Html.AntiForgeryToken()
                    <input asp-for="TermsOfService.Id" type="hidden" />
                    <input asp-for="TermsOfService.RowVersion" type="hidden" />
                    <input asp-for="TermsOfService.LastUpdated" type="hidden" />

                    <div class="simple-editor__field">
                        <label class="privacy-editor__label">Last Updated</label>
                        <input asp-for="TermsOfService.TemplateData.IntroLastUpdated" class="privacy-editor__input" />
                    </div>

                    <div class="simple-editor__field">
                        <label class="privacy-editor__label">Introduction</label>
                        <div class="simple-editor__toolbar">
                            <button type="button" class="simple-editor__btn" data-command="bold">Bold</button>
                            <button type="button" class="simple-editor__btn" data-command="italic">Italic</button>
                            <button type="button" class="simple-editor__btn" data-command="insertUnorderedList">Bullets</button>
                            <button type="button" class="simple-editor__btn" data-command="createLink">Link</button>
                        </div>
                        <div class="simple-editor__rich-text" contenteditable="true" data-input="TermsOfService.TemplateData.IntroText">@Html.Raw(Model.TermsOfService.TemplateData.IntroText)</div>
                        <input type="hidden" name="TermsOfService.TemplateData.IntroText" value="@Model.TermsOfService.TemplateData.IntroText" />
                    </div>

                    <div class="simple-editor__sections-container">
                        @for (var i = 0; i < Model.TermsOfService.TemplateData.Sections.Count; i++)
                        {
                            var policySection = Model.TermsOfService.TemplateData.Sections[i];
                            <div class="simple-editor__section" data-section-index="@i">
                                <div class="simple-editor__section-header">
                                    <h4 class="simple-editor__section-title">Section @(i + 1)</h4>
                                    <button type="button" class="simple-editor__remove-section admin-settings-btn admin-settings-btn--danger">Remove</button>
                                </div>
                                <label class="privacy-editor__label">Section Title</label>
                                <input name="@($"TermsOfService.TemplateData.Sections[{i}].Title")" value="@policySection.Title" class="privacy-editor__input" />

                                <label class="privacy-editor__label">Section Text</label>
                                <div class="simple-editor__toolbar">
                                    <button type="button" class="simple-editor__btn" data-command="bold">Bold</button>
                                    <button type="button" class="simple-editor__btn" data-command="italic">Italic</button>
                                    <button type="button" class="simple-editor__btn" data-command="insertUnorderedList">Bullets</button>
                                    <button type="button" class="simple-editor__btn" data-command="createLink">Link</button>
                                </div>
                                <div class="simple-editor__rich-text" contenteditable="true" data-input="@($"TermsOfService.TemplateData.Sections[{i}].Body")">@Html.Raw(policySection.Body)</div>
                                <input type="hidden" name="@($"TermsOfService.TemplateData.Sections[{i}].Body")" value="@policySection.Body" />

                                <label class="privacy-editor__label">Bullet List (one per line)</label>
                                <textarea name="@($"TermsOfService.TemplateData.Sections[{i}].BulletsText")" class="privacy-editor__textarea" rows="4">@policySection.BulletsText</textarea>

                                <label class="privacy-editor__label">Highlight Title (optional)</label>
                                <input name="@($"TermsOfService.TemplateData.Sections[{i}].HighlightTitle")" value="@policySection.HighlightTitle" class="privacy-editor__input" />

                                <label class="privacy-editor__label">Highlight Text (optional)</label>
                                <div class="simple-editor__toolbar">
                                    <button type="button" class="simple-editor__btn" data-command="bold">Bold</button>
                                    <button type="button" class="simple-editor__btn" data-command="italic">Italic</button>
                                    <button type="button" class="simple-editor__btn" data-command="insertUnorderedList">Bullets</button>
                                    <button type="button" class="simple-editor__btn" data-command="createLink">Link</button>
                                </div>
                                <div class="simple-editor__rich-text" contenteditable="true" data-input="@($"TermsOfService.TemplateData.Sections[{i}].HighlightBody")">@Html.Raw(policySection.HighlightBody)</div>
                                <input type="hidden" name="@($"TermsOfService.TemplateData.Sections[{i}].HighlightBody")" value="@policySection.HighlightBody" />
                            </div>
                        }
                    </div>

                    <button type="button" class="simple-editor__add-section admin-settings-btn admin-settings-btn--secondary" data-prefix="TermsOfService">+ Add Section</button>

                    <div class="simple-editor__field">
                        <label class="privacy-editor__label">Footer Text</label>
                        <div class="simple-editor__toolbar">
                            <button type="button" class="simple-editor__btn" data-command="bold">Bold</button>
                            <button type="button" class="simple-editor__btn" data-command="italic">Italic</button>
                            <button type="button" class="simple-editor__btn" data-command="insertUnorderedList">Bullets</button>
                            <button type="button" class="simple-editor__btn" data-command="createLink">Link</button>
                        </div>
                        <div class="simple-editor__rich-text" contenteditable="true" data-input="TermsOfService.TemplateData.FooterText">@Html.Raw(Model.TermsOfService.TemplateData.FooterText)</div>
                        <input type="hidden" name="TermsOfService.TemplateData.FooterText" value="@Model.TermsOfService.TemplateData.FooterText" />
                    </div>

                    <div class="simple-editor__field">
                        <label class="privacy-editor__label">Contact Lines (one per line)</label>
                        <textarea name="TermsOfService.TemplateData.ContactLinesText" class="privacy-editor__textarea" rows="4">@Model.TermsOfService.TemplateData.ContactLinesText</textarea>
                    </div>

                    <div class="privacy-editor__actions">
                        <button type="submit" class="admin-settings-btn admin-settings-btn--primary">Save Terms of Service</button>
                    </div>
                </form>
            </div>
        </section>

        <!-- Gallery Page -->
        <section class="gallery-page">
            <div class="gallery-page__header">
                <div>
                    <h3 class="gallery-page__title">Gallery Management</h3>
                    <p class="gallery-page__description">Upload and manage photos for the gallery page</p>
                </div>
            </div>
            
            @if (TempData["GallerySuccess"] != null)
            {
                <div class="alert alert-success" style="padding: 12px; background: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px; color: #155724; margin-bottom: 16px;">
                    @TempData["GallerySuccess"]
                </div>
            }
            @if (TempData["GalleryError"] != null)
            {
                <div class="alert alert-danger" style="padding: 12px; background: #f8d7da; border: 1px solid #f5c6cb; border-radius: 8px; color: #721c24; margin-bottom: 16px;">
                    @TempData["GalleryError"]
                </div>
            }
            
            <form asp-area="Admin" asp-controller="SiteSettings" asp-action="AddGalleryItem" method="post" enctype="multipart/form-data" class="gallery-page__form" id="galleryForm">
                @Html.AntiForgeryToken()
                
                <div class="gallery-page__upload-field">
                    <label class="gallery-page__label">Upload Photo(s) *</label>
                    <input type="file" name="images" id="imageUpload" accept="image/*" multiple required />
                    <div class="gallery-page__upload-area" id="uploadArea" style="cursor: pointer;">
                        <div class="gallery-page__upload-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/>
                            </svg>
                        </div>
                        <p class="gallery-page__upload-text" id="uploadText">Click to upload or drag and drop</p>
                    </div>
                </div>
                
                <div class="gallery-page__field">
                    <label class="gallery-page__label">Alt Text / Description *</label>
                    <input type="text" name="altText" class="gallery-page__input" placeholder="Enter photo description" required />
                </div>
                
                <div class="gallery-page__field">
                    <label class="gallery-page__label" style="display: flex; align-items: center; gap: 8px;">
                        <input type="hidden" name="isAlbum" value="false" />
                        <input type="checkbox" name="isAlbum" id="isAlbumCheckbox" value="true" />
                        This is an album (multiple photos in collection)
                    </label>    
                </div>
                
                <div id="albumFields" style="display: none;">
                    <div class="gallery-page__field">
                        <label class="gallery-page__label">Number of Photos in Album</label>
                        <input type="number" name="albumPhotoCount" class="gallery-page__input" placeholder="e.g., 12" min="1" />
                    </div>
                    
                    <div class="gallery-page__field">
                        <label class="gallery-page__label">Collection *</label>
                        <select name="collectionId" id="collectionSelect" class="gallery-page__select">
                            <option value="">Select a collection</option>
                            @if (ViewBag.ExistingCollections != null && ViewBag.ExistingCollections.Count > 0)
                            {
                                <optgroup label="Existing Collections">
                                    @foreach (var collection in ViewBag.ExistingCollections)
                                    {
                                        <option value="@collection">@collection</option>
                                    }
                                </optgroup>
                            }
                            <optgroup label="Preset Collections">
                                <option value="Workshop Photos">Workshop Photos</option>
                                <option value="Event Highlights">Event Highlights</option>
                                <option value="Community Stories">Community Stories</option>
                                <option value="Annual Gatherings">Annual Gatherings</option>
                                <option value="Volunteer Activities">Volunteer Activities</option>
                                <option value="Book Donations">Book Donations</option>
                                <option value="Writing Workshops">Writing Workshops</option>
                                <option value="Support Groups">Support Groups</option>
                            </optgroup>
                            <option value="__custom__">+ Create New Collection</option>
                        </select>
                    </div>
                    
                    <div class="gallery-page__field" id="customCollectionField" style="display: none;">
                        <label class="gallery-page__label">New Collection Name *</label>
                        <input type="text" id="customCollectionInput" class="gallery-page__input" placeholder="Enter new collection name" />
                    </div>
                </div>
                
                <div class="gallery-page__actions">
                    <button type="submit" class="admin-settings-btn admin-settings-btn--primary gallery-page__btn-add">Add Photo</button>
                    <button type="reset" class="admin-settings-btn admin-settings-btn--secondary gallery-page__btn-cancel">Clear</button>
                </div>
            </form>
            
            <!-- Display Existing Gallery Items -->
            @if (Model.GalleryItems != null && Model.GalleryItems.Any())
            {
                <div style="margin-top: 32px;">
                    <h4 style="margin-bottom: 16px; font-size: 1.125rem; font-weight: 600;">Current Gallery Items</h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px;">
                        @foreach (var item in Model.GalleryItems)
                        {
                            <div style="position: relative; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden;">
                                <img src="@item.ImageUrl" alt="@item.AltText" style="width: 100%; height: 150px; object-fit: cover;" />
                                <div style="padding: 8px; font-size: 0.75rem;">
                                    <div style="font-weight: 500; margin-bottom: 4px;">@item.AltText</div>
                                    @if (!string.IsNullOrEmpty(item.CollectionId))
                                    {
                                        <div style="color: #6b7280;">Collection: @item.CollectionId</div>
                                    }
                                    @if (item.IsAlbum)
                                    {
                                        <div style="color: #6b7280;">Album (@item.AlbumPhotoCount photos)</div>
                                    }
                                </div>
                                <form asp-area="Admin" asp-controller="SiteSettings" asp-action="DeleteGalleryItem" method="post" style="position: absolute; top: 8px; right: 8px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" onclick="return confirm('Delete this photo?')" class="admin-settings-btn admin-settings-btn--danger gallery-item__btn-delete">Delete</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>
        
    </div>

    <!-- Our Impact Section -->
    <section class="our-impact">
        <div class="our-impact__header">
            <h2 class="our-impact__title">Our Impact Metrics</h2>
            <p class="our-impact__description">Update the impact statistics displayed on the home page</p>
        </div>
        
        @if (TempData["OurImpactSuccess"] != null)
        {
            <div class="alert alert-success" style="padding: 12px; background: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px; color: #155724; margin-bottom: 16px;">
                @TempData["OurImpactSuccess"]
            </div>
        }
        
        <form asp-area="Admin" asp-controller="SiteSettings" asp-action="UpdateOurImpact" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="OurImpact.Id" type="hidden" />
            <input asp-for="OurImpact.RowVersion" type="hidden" />
            
            <div class="our-impact__grid">
                <div class="our-impact__field">
                    <label asp-for="OurImpact.PeopleHelped" class="our-impact__label">People Helped</label>
                    <input asp-for="OurImpact.PeopleHelped" type="number" class="our-impact__input" placeholder="0" min="0" />
                    <span asp-validation-for="OurImpact.PeopleHelped" class="text-danger"></span>
                </div>
                
                <div class="our-impact__field">
                    <label asp-for="OurImpact.WorkshopsHosted" class="our-impact__label">Workshops Hosted</label>
                    <input asp-for="OurImpact.WorkshopsHosted" type="number" class="our-impact__input" placeholder="0" min="0" />
                    <span asp-validation-for="OurImpact.WorkshopsHosted" class="text-danger"></span>
                </div>
                
                <div class="our-impact__field">
                    <label asp-for="OurImpact.PartnerOrganisations" class="our-impact__label">Partner Organisations</label>
                    <input asp-for="OurImpact.PartnerOrganisations" type="number" class="our-impact__input" placeholder="0" min="0" />
                    <span asp-validation-for="OurImpact.PartnerOrganisations" class="text-danger"></span>
                </div>
                
                <div class="our-impact__field">
                    <label asp-for="OurImpact.CitiesReached" class="our-impact__label">Cities Reached</label>
                    <input asp-for="OurImpact.CitiesReached" type="number" class="our-impact__input" placeholder="0" min="0" />
                    <span asp-validation-for="OurImpact.CitiesReached" class="text-danger"></span>
                </div>
            </div>
            
            <div class="our-impact__actions">
                <button type="submit" class="admin-settings-btn admin-settings-btn--primary our-impact__btn-save">Save</button>
            </div>
        </form>
    </section>
    
